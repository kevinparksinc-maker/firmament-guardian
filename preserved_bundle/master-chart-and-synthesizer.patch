+      domain: "autonomy_power",
+      causalMechanism: `Mars at ${mars.display} in ${marsSign} (House ${mars.house})`,
+      valence: "transformative",
+      strength: "strong",
+      tradition: "Hellenistic & Vedic Graha Drishti",
