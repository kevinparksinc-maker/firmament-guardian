+              href="/energy"
+              className="inline-flex items-center gap-1.5 rounded-xl border border-[#D9B66F]/50 bg-[#D9B66F]/10 px-4 py-2.5 text-xs font-bold text-[#D9B66F] hover:bg-[#D9B66F]/20 transition-all active:scale-95 shrink-0"
