+  // 2. Emotional Instincts & Inner Equilibrium (Moon)
+  if (moon) {
+    const moonSign = getSign(moon.longitude);
+    const moonNakshatra = (snapshot.layers["vedic-nakshatras-and-padas"]?.results as any[])?.find(
+      (n: any) => n.body === "Moon"
